<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Keystore keys do not travel with a backup. Legacy Flutter preferences
         also contain wallet/Supabase credentials; Android excludes files, not keys. -->
    <exclude domain="sharedpref" path="chumbucket_wallet_secure.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    <!-- The on-phone wallet's encrypted store: restored without its Keystore
         key it cannot be read. Its own copy travels in Block Store instead. -->
    <exclude domain="sharedpref" path="chumbucket_embedded_wallet.xml" />
</full-backup-content>
