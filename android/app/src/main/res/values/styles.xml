<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch window, light or dark system mode alike: the app is
         light-only, so the canvas is #F4F4F4 with the bucket centred and no
         flash on the hand-off to Flutter. Android 12+ uses the
         windowSplashScreen* attributes (values-v31). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- Behind Flutter's UI once it draws: the same canvas. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
