<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Internet permission for webviews and URL launcher -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for push notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vibrate permission for notification vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The boot-completed permission was removed: the app schedules no notifications
         (no zonedSchedule / periodicallyShow) and declares no boot receiver, so
         the permission granted nothing and only widened the review surface. -->

    <application
        android:label="Chumbucket"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dev.cleva.chumbucket" android:host="login-callback" />
            </intent-filter>

            <!-- Shared call / person / market links: https App Links.
                 https://chumbucket.fun/c/<callId>, /u/<handle>, /m/<marketId>
                 open straight in the app once Android has verified
                 https://chumbucket.fun/.well-known/assetlinks.json (served by
                 the site in the API repo, web/app/.well-known). Until that file
                 carries the release certificate's SHA-256, verification fails
                 and the same links simply open the website, which has its own
                 open-in-app / install fallback. Nothing breaks either way.

                 Only these three path prefixes are claimed, so every other page
                 on the site keeps opening in the browser. The hosts are exactly
                 kCallDeepLinkHosts in lib/features/calls/deeplink/call_deep_link.dart;
                 the OAuth filter above is untouched. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="chumbucket.fun" />
                <data android:host="www.chumbucket.fun" />
                <data android:pathPrefix="/c/" />
                <data android:pathPrefix="/u/" />
                <data android:pathPrefix="/m/" />
            </intent-filter>
            <!-- The same links on the app's own schemes. The app owns these by
                 registration, with no domain to verify; the website's
                 "Open in app" button uses them. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dev.cleva.chumbucket" android:host="c" />
                <data android:scheme="dev.cleva.chumbucket" android:host="u" />
                <data android:scheme="dev.cleva.chumbucket" android:host="m" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="chumbucket" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- FCM default notification channel. Must equal
             NotificationChannels.activity in
             lib/core/services/notification_service.dart. A push that names a
             channel this app no longer creates (the legacy edge function still
             sends "challenge_channel") falls back to this one. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="activity_channel" />
        <!-- Crash reports are opt-in. Nothing is collected until the person
             turns "Share crash reports" on in Settings, which calls
             setCrashlyticsCollectionEnabled(true) (lib/core/crash/crash_reporting.dart). -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <!-- FCM default notification icon -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/launcher_icon" />
        <!-- Network security config for Flutter -->
        <meta-data
            android:name="io.flutter.network-policy"
            android:resource="@xml/network_security_config" />
        <!-- Sign-in link proofs (flutter_web_auth_2): the auth session returns
             here, on a host of its own, so it never reaches MainActivity's
             login-callback or share-link filters. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dev.cleva.chumbucket" android:host="link-callback" />
            </intent-filter>
        </activity>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required for url_launcher to query browser apps -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Add funds: Crossmint's checkout runs in a WebView with the Payment
             Request API on, so Google Pay can open. Android needs these to see
             the payment apps (docs.crossmint.com/payments/embedded/guides/webview-integration). -->
        <intent>
            <action android:name="org.chromium.intent.action.PAY" />
        </intent>
        <intent>
            <action android:name="org.chromium.intent.action.IS_READY_TO_PAY" />
        </intent>
        <intent>
            <action android:name="org.chromium.intent.action.UPDATE_PAYMENT_DETAILS" />
        </intent>
    </queries>
</manifest>
